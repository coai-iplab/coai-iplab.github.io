---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { GraduationCap, ExternalLink, Presentation } from "lucide-react";
import { COLORS } from "../../utils/constants";

export async function getStaticPaths() {
  const team = await getCollection("team");
  return team.map((member) => ({
    params: { id: member.id },
    props: { member },
  }));
}

const { member } = Astro.props;

// Fetch publications and filter by member name
const allPublications = (await getCollection("publications")).map((p) => ({
  ...p,
  data: {
    ...p.data,
    links: p.data.links?.filter((l) => l.label.toLowerCase() !== "doi") || [],
  },
}));
const lastName = member.data.name.split(" ").pop() || "";
const order2026 = [
  "viterbiplannet",
  "task graph maximum likelihood estimation",
  "ti-prego",
  "integrating affordances and attention",
  "proskill",
  "ego-extra",
  "online episodic memory visual query localization",
  "exploring multimodal"
];

const memberPublications = allPublications
  .filter(
    (pub) =>
      pub.data.active !== false &&
      pub.data.authors.toLowerCase().includes(lastName.toLowerCase()),
  )
  .sort((a, b) => {
    // 1. Year comparison (descending)
    const yearDiff = b.data.year.localeCompare(a.data.year);
    if (yearDiff !== 0) return yearDiff;

    // 2. Specific override for 2026
    if (a.data.year === "2026") {
      const titleA = a.data.title.toLowerCase();
      const titleB = b.data.title.toLowerCase();
      
      const indexA = order2026.findIndex(prefix => titleA.includes(prefix));
      const indexB = order2026.findIndex(prefix => titleB.includes(prefix));
      
      if (indexA !== -1 && indexB !== -1) return indexA - indexB;
      if (indexA !== -1) return -1;
      if (indexB !== -1) return 1;
    }

    // 3. General rule: journals go first, conferences after
    const typeA = a.data.pub_type === "journal" ? 0 : 1;
    const typeB = b.data.pub_type === "journal" ? 0 : 1;
    if (typeA !== typeB) return typeA - typeB;

    // 4. Default fallback: title alphabetical
    return a.data.title.localeCompare(b.data.title);
  });

const teamMembers = await getCollection("team");

const renderAuthors = (authorsStr: string) => {
  const authors = authorsStr
    .split(/,\s*|\s+and\s+;\s*/)
    .map((a) => a.trim())
    .filter(Boolean);
  return authors.map((author) => {
    let matchedMember: any = null;
    const isLab = teamMembers.some((m) => {
      const r = m.data.name.trim();
      const n1 = r.toLowerCase().replace(/[\.\s-]/g, "");
      const n2 = author.toLowerCase().replace(/[\.\s-]/g, "");
      if (n1 === n2 || n2.includes(n1) || n1.includes(n2)) {
        matchedMember = m;
        return true;
      }

      const rParts = r.split(" ");
      const rLastName = rParts[rParts.length - 1].toLowerCase();
      const aLastName = author.split(" ").pop()?.toLowerCase() || "";

      if (rLastName === aLastName) {
        const rFirstInit = rParts[0][0].toLowerCase();
        if (author[0].toLowerCase() === rFirstInit) {
          matchedMember = m;
          return true;
        }
      }
      return false;
    });

    return { name: author, isLab, id: matchedMember?.id };
  });
};

// Fetch talks and filter by speakerId
const allTalks = await getCollection("engagements");
const memberTalks = allTalks.filter((talk) => {
  const ids = Array.isArray(talk.data.speakerId)
    ? talk.data.speakerId
    : [talk.data.speakerId];
  return ids.includes(member.id);
});

const getAvatar = (seed: string, colorHex: string) =>
  `https://api.dicebear.com/7.x/initials/svg?seed=${encodeURIComponent(seed)}&backgroundColor=${colorHex.replace("#", "")}`;

const getPrimaryLink = (pub: any) => {
  if (!pub.data.links || pub.data.links.length === 0) return "#";
  const preferred = ["pdf", "project", "paper", "doi"];
  for (const label of preferred) {
    const found = pub.data.links.find((l) =>
      l.label.toLowerCase().includes(label),
    );
    if (found) return found.url;
  }
  return pub.data.links[0].url;
};

const getTeaserUrl = (teaser?: string) => {
  if (!teaser) return undefined;
  if (teaser.startsWith("http")) return teaser;
  return teaser;
};
---

<Layout title={`Co-AI Research Group | ${member.data.name}`}>
  <div
    class="space-y-12 animate-in fade-in slide-in-from-bottom-4 duration-700 max-w-5xl"
  >
    {/* Member Details Hero */}
    <div
      class="bg-white dark:bg-gray-900 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-800 overflow-hidden relative"
    >
      <div
        class="h-48 w-full"
        style={`background: linear-gradient(135deg, ${member.data.color}, ${COLORS.teal});`}
      >
      </div>
      <div class="px-8 pb-8">
        <div
          class="relative flex flex-col sm:flex-row justify-between items-start sm:items-end -mt-20 mb-6 gap-4"
        >
          <div
            class="w-36 h-36 bg-white dark:bg-gray-850 rounded-3xl p-1.5 shadow-lg flex-shrink-0"
          >
            <img
              src={member.data.profile ||
                member.data.image ||
                getAvatar(member.data.name, member.data.color)}
              alt={member.data.name}
              class="w-full h-full rounded-2xl object-cover bg-gray-50 dark:bg-gray-800"
            />
          </div>
          <div class="flex-grow">
            <h1
              class="text-4xl font-[900] text-white tracking-tight leading-none mb-2"
            >
              {member.data.name}
            </h1>
            <p
              class="font-[900] text-lg uppercase tracking-wider mb-2"
              style={`color: ${member.data.color};`}
            >
              {member.data.role}
            </p>
            <div
              class="flex items-center text-gray-500 dark:text-gray-400 text-sm font-[800]"
            >
              <GraduationCap size={18} class="mr-2" />
              {member.data.affiliation}
            </div>
          </div>
          {
            member.data.link !== "#" && (
              <a
                href={member.data.link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center px-5 py-3 bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 hover:bg-blue-100 dark:hover:bg-blue-900/40 hover:text-blue-800 dark:hover:text-blue-300 rounded-2xl font-[900] transition-colors gap-2 self-stretch sm:self-auto justify-center"
              >
                Personal Site <ExternalLink size={18} />
              </a>
            )
          }
        </div>

        <div
          class="prose prose-zinc dark:prose-invert max-w-none border-t border-gray-100 dark:border-gray-800 pt-6"
        >
          <h3
            class="text-xs font-[900] text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-4"
          >
            About
          </h3>
          <p
            class="text-gray-700 dark:text-gray-300 leading-relaxed text-lg font-[600] whitespace-pre-line"
          >
            {member.body}
          </p>
        </div>
      </div>
    </div>

    {/* Publications Section */}
    {
      memberPublications.length > 0 && (
        <div class="space-y-6">
          <h3 class="text-xs font-[900] text-gray-400 dark:text-gray-500 uppercase tracking-widest px-2 border-l-4 border-gray-400 dark:border-gray-500">
            Publications
          </h3>
          <div class="space-y-4">
            {memberPublications.map((pub) => {
              const primaryLink = getPrimaryLink(pub);
              const teaserUrl = getTeaserUrl(pub.data.teaser);

              return (
                <div class="bg-white dark:bg-gray-900 p-6 rounded-3xl border border-gray-100 dark:border-gray-800 shadow-sm hover:shadow-md transition-shadow group flex flex-col md:flex-row gap-6 items-center">
                  {teaserUrl ? (
                    <div class="flex-shrink-0 w-full md:w-48 h-28 rounded-xl overflow-hidden bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-800 flex items-center justify-center p-2">
                      <img
                        src={teaserUrl}
                        alt={pub.data.title}
                        class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-300"
                      />
                    </div>
                  ) : (
                    <div
                      class="flex-shrink-0 w-full md:w-48 h-28 rounded-xl flex flex-col items-center justify-center font-[900] text-xl"
                      style={`background-color: ${COLORS.navy}08; color: ${COLORS.navy};`}
                    >
                      {pub.data.year}
                    </div>
                  )}
                  <div class="flex-grow w-full">
                    <div class="flex flex-wrap items-center gap-2 mb-2">
                      <span
                        class="text-[10px] font-[900] px-3 py-1 rounded-full uppercase tracking-wider"
                        style={`background-color: ${pub.data.pub_type === "journal" ? COLORS.purple : COLORS.teal}15; color: ${pub.data.pub_type === "journal" ? COLORS.purple : COLORS.teal};`}
                      >
                        {pub.data.pub_type}
                      </span>
                      <span class="text-[10px] font-[900] px-2 py-1 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 font-mono">
                        {pub.data.year}
                      </span>
                      {pub.data.award &&
                        pub.data.award
                          .split(";")
                          .map((aw) => (
                            <span class="text-[10px] font-[900] px-2 py-1 rounded-full bg-amber-50 dark:bg-amber-950/20 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-900/30 uppercase tracking-wider flex items-center gap-1">
                              🏆 {aw.trim()}
                            </span>
                          ))}
                    </div>
                    <a
                      href={`/research/${pub.id}`}
                      class="text-lg md:text-xl font-[900] text-gray-900 dark:text-white group-hover:text-blue-700 dark:group-hover:text-blue-400 transition-colors block mb-2 leading-tight"
                    >
                      {pub.data.title}
                    </a>
                    <p class="text-gray-700 dark:text-gray-300 font-[800] text-sm mb-1">
                      {renderAuthors(pub.data.authors).map(
                        (author, index, arr) => (
                          <span>
                            {author.isLab ? (
                              <a
                                href={
                                  author.id === "davide_moltisanti"
                                    ? "https://www.davidemoltisanti.com/research/"
                                    : `/team/${author.id}`
                                }
                                class={
                                  author.id === "davide_moltisanti"
                                    ? "font-[800] hover:text-blue-700 dark:hover:text-blue-400 transition-colors"
                                    : "underline decoration-gray-400 dark:decoration-gray-650 underline-offset-4 font-[800] hover:text-blue-700 dark:hover:text-blue-400 transition-colors"
                                }
                              >
                                {author.name}
                              </a>
                            ) : (
                              <span>{author.name}</span>
                            )}
                            {index < arr.length - 1 ? ", " : ""}
                          </span>
                        ),
                      )}
                    </p>
                    <p class="text-gray-500 dark:text-gray-400 text-xs italic font-[600] mb-3">
                      {pub.data.venue}
                    </p>

                    <div class="flex flex-wrap gap-2 items-center">
                      {pub.data.links && pub.data.links.length > 0 && (
                        <div class="flex flex-wrap gap-2">
                          {pub.data.links.map((l) => (
                            <a
                              href={l.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="inline-flex items-center text-[10px] font-[900] text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/40 hover:bg-blue-100 dark:hover:bg-blue-900/40 px-2.5 py-1 rounded-lg transition-colors"
                            >
                              {l.label} <ExternalLink size={10} class="ml-1" />
                            </a>
                          ))}
                        </div>
                      )}
                      {pub.data.bibtex && (
                        <>
                          <button
                            onclick={`document.getElementById('bibtex-dialog-${pub.id}').showModal()`}
                            class="inline-flex items-center text-[10px] font-[900] text-teal-600 dark:text-teal-400 bg-teal-50 dark:bg-teal-950/40 hover:bg-teal-100 dark:hover:bg-teal-900/40 px-2.5 py-1 rounded-lg transition-colors cursor-pointer"
                          >
                            BibTeX
                          </button>
                          <dialog
                            id={`bibtex-dialog-${pub.id}`}
                            class="rounded-3xl border border-gray-100 dark:border-gray-800 p-0 shadow-2xl max-w-2xl w-full backdrop:bg-black/50 overflow-hidden mx-auto my-auto fixed inset-0 bg-white dark:bg-gray-900"
                            onclick="event.target === this && this.close()"
                          >
                            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900">
                              <span class="text-xs font-[900] uppercase tracking-widest text-gray-400 dark:text-gray-500">
                                BibTeX Citation
                              </span>
                              <button
                                onclick="this.closest('dialog').close()"
                                class="text-gray-400 hover:text-gray-900 dark:text-gray-500 dark:hover:text-white transition-colors text-2xl font-[900] cursor-pointer"
                              >
                                &times;
                              </button>
                            </div>
                            <pre class="p-6 text-xs font-mono text-gray-700 dark:text-gray-300 bg-gray-50 dark:bg-gray-950 overflow-x-auto whitespace-pre leading-relaxed">
                              {pub.data.bibtex}
                            </pre>
                            <div class="px-6 py-4 border-t border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900 flex justify-end">
                              <button
                                onclick="navigator.clipboard.writeText(this.closest('dialog').querySelector('pre').textContent); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy', 1500)"
                                class="px-4 py-2 bg-blue-50 hover:bg-blue-100 dark:bg-blue-950/40 dark:hover:bg-blue-900/40 text-blue-600 dark:text-blue-450 rounded-xl font-[900] text-xs uppercase tracking-wider transition-colors cursor-pointer"
                              >
                                Copy
                              </button>
                            </div>
                          </dialog>
                        </>
                      )}
                    </div>

                    {pub.data.related &&
                      (() => {
                        const relatedEntry = allPublications.find(
                          (p) =>
                            p.id.toLowerCase() ===
                            pub.data.related.toLowerCase(),
                        );
                        if (!relatedEntry) return null;
                        return (
                          <div class="mt-4 p-3 bg-gray-50/75 dark:bg-gray-950/40 border border-gray-100 dark:border-gray-800 rounded-2xl flex flex-col md:flex-row gap-3 items-start md:items-center justify-between">
                            <div class="space-y-1">
                              <div class="flex items-center gap-1.5">
                                <span
                                  class="text-[8px] font-[900] px-2 py-0.5 rounded-full uppercase tracking-wider font-mono"
                                  style={`background-color: ${relatedEntry.data.pub_type === "journal" ? COLORS.purple : COLORS.teal}15; color: ${relatedEntry.data.pub_type === "journal" ? COLORS.purple : COLORS.teal};`}
                                >
                                  {relatedEntry.data.pub_type === "journal"
                                    ? "Journal Version"
                                    : "Conference Version"}
                                </span>
                                <span class="text-[9px] font-[900] px-1.5 py-0.5 rounded-full bg-gray-200 dark:bg-gray-800 text-gray-500 dark:text-gray-400 font-mono">
                                  {relatedEntry.data.year}
                                </span>
                              </div>
                              <a
                                href={`/research/${relatedEntry.id}`}
                                class="text-xs font-[900] text-gray-800 dark:text-gray-200 hover:text-blue-700 dark:hover:text-blue-400 transition-colors block leading-snug"
                              >
                                {relatedEntry.data.title}
                              </a>
                            </div>
                            {relatedEntry.data.links &&
                              relatedEntry.data.links.length > 0 && (
                                <div class="flex flex-wrap gap-1.5 flex-shrink-0">
                                  {relatedEntry.data.links.map((l) => (
                                    <a
                                      href={l.url}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      class="inline-flex items-center text-[9px] font-[900] text-blue-600 dark:text-blue-400 bg-blue-50/70 dark:bg-blue-950/30 px-2 py-0.5 rounded-lg transition-colors"
                                    >
                                      {l.label}{" "}
                                      <ExternalLink size={8} class="ml-0.5" />
                                    </a>
                                  ))}
                                </div>
                              )}
                          </div>
                        );
                      })()}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )
    }

    {/* Talks Section */}
    {
      memberTalks.length > 0 && (
        <div class="space-y-6">
          <h3 class="text-xs font-[900] text-gray-400 dark:text-gray-500 uppercase tracking-widest px-2 border-l-4 border-gray-400 dark:border-gray-500">
            Talks & Presentations
          </h3>
          <div class="space-y-4">
            {memberTalks.map((talk) => (
              <div class="bg-white dark:bg-gray-900 p-6 rounded-3xl border border-gray-100 dark:border-gray-800 shadow-sm flex flex-col sm:flex-row gap-6 hover:shadow-md transition-shadow">
                <div class="flex-shrink-0 w-12 h-12 rounded-xl flex items-center justify-center bg-gray-50 dark:bg-gray-850 text-gray-500 dark:text-gray-400 border border-gray-100 dark:border-gray-800">
                  <Presentation size={24} />
                </div>
                <div class="flex-grow">
                  <div class="flex items-center gap-3 mb-1">
                    <span class="text-xs font-[900] text-gray-400 dark:text-gray-500 font-mono">
                      {talk.data.date}
                    </span>
                    <span
                      class="px-2.5 py-0.5 rounded-full text-[10px] font-[800] uppercase tracking-wider"
                      style={`background-color: ${COLORS.teal}15; color: ${COLORS.teal};`}
                    >
                      {talk.data.type}
                    </span>
                  </div>
                  <h4 class="text-lg font-[900] text-gray-900 dark:text-white mb-1">
                    {talk.data.title}
                  </h4>
                  <p class="text-gray-600 dark:text-gray-300 font-[700] text-sm mb-3">
                    {talk.data.venue}
                  </p>
                  {talk.data.slides && talk.data.slides !== "visapp2019" && (
                    <a
                      href={talk.data.slides}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center text-xs font-[900] text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/40 px-3 py-1.5 rounded-lg transition-colors"
                    >
                      Slides <ExternalLink size={12} class="ml-1" />
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </div>
</Layout>
