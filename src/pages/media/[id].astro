                            {ea.projectUrl ? (
                              <a
                                href={ea.projectUrl}
                                target="_blank"
                                rel="noopener"
                                style="color: #1b285c; font-weight: 900; text-decoration: underline; text-underline-offset: 1px;"
                              >
                                {ea.title}
                              </a>
                            ) : (
                              <span style="color: #1b285c; font-weight: 900;">
                                {ea.title}
                              </span>
                            )}
                            ,{" "}
                            {ea.workshopUrl ? (
                              <a
                                href={ea.workshopUrl}
                                target="_blank"
                                rel="noopener"
                                style="color: #2a9d8f; text-decoration: underline; font-weight: 800;"
                              >
                                {ea.workshop}
                              </a>
                            ) : (
                              <span style="color: #2a9d8f; font-weight: 800;">
                                {ea.workshop}
