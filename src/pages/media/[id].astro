              )}

              {/* Paper Card Item */}
              {item.type === "paper" &&
                (() => {
                  return (
                    <div
                      class="schedule-card"
                      style="margin-bottom: 0; width: 100%; box-sizing: border-box; background: #fff4ec; padding: 1rem; border-radius: 20px;"
