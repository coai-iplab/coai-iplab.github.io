                      {item.data.previewUrl && (
                        <a
                          href={item.data.previewUrl}
                          style="display: inline-flex; align-items: center; gap: 0.3rem; margin-top: 0.6rem; font-size: 0.6rem; font-weight: 900; color: #1b285c; background: #1b285c15; border: 1px solid #1b285c40; padding: 0.25rem 0.7rem; border-radius: 999px; text-decoration: none; letter-spacing: 0.04em; text-transform: uppercase;"
                        >
                          📄 Talk Preview
                        </a>
                      )}
                    </div>
                  </div>
                ))}

              {/* Extended Abstracts Card Item */}
              {item.type === "abstract" && (
                <div
                  class="talk-card"
                  style="margin-bottom: 0; display: flex; flex-direction: column; gap: 0.75rem; align-items: stretch;"
                >
                  {/* Row 1: Date and Badges */}
                  <div style="display: flex; align-items: center; gap: 0.85rem;">
                    <div class="cal-icon" aria-hidden="true">
                      <div class="cal-rings">
                        <span />
                        <span />
                      </div>
                      <div class="cal-body">
                        <span class="cal-month">JUN</span>
                        <span class="cal-day">3</span>
                      </div>
                    </div>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; flex: 1; min-width: 0;">
                      <span
                        class="type-pill orange-bg"
                        style="margin-bottom: 0;"
                      >
                        EXTENDED ABSTRACTS
                      </span>
                      <span
                        class="type-pill teal-pill"
                        style="margin-bottom: 0;"
                      >
                        COLLABORATIONS WITH OTHER GROUPS
                      </span>
                    </div>
                  </div>
                  {/* Row 2: Bullet List */}
                  <div
                    class="abstracts-list-container"
                    style="padding: 0 0.25rem;"
                  >
                    <ul style="list-style-type: disc; padding-left: 1.1rem; margin: 0; display: flex; flex-direction: column; gap: 0.5rem;">
                      {item.data.map((ea) => {
                        const authorsList = ea.authors
                          .split(/, | and /g)
                          .map((a) => a.trim());
                        return (
                          <li style="font-size: 0.65rem; font-weight: 700; color: #374151; line-height: 1.4;">
                            {authorsList.map((author, index) => (
                              <span>
                                {isGroupMember(author) ? (
                                  <span class="underline decoration-gray-400 font-[900]">
                                    {author}
                                  </span>
                                ) : (
                                  <span>{author}</span>
                                )}
                                {index < authorsList.length - 1 ? ", " : ""}
                              </span>
                            ))}
