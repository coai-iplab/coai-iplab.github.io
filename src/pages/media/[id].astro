                                    <a
                                      href={`/team/${ch.organizerId}`}
                                      class="challenge-organizer"
                                    >
                                      {ch.organizer}
                                    </a>
                                  ) : (
                                    <span class="challenge-organizer">
                                      {ch.organizer}
                                    </span>
                                  )}
                                </li>
                              ))}
                            </ul>
                          </div>
