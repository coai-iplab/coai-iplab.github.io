                                      style="color: inherit; text-decoration: none; font-weight: 800;"
                                    >
                                      Davide Moltisanti (University of Bath)
                                    </a>
                                  ) : isGroupMember(author) ? (
                                    <span class="underline decoration-gray-400 font-[900]">
                                      {author}
                                    </span>
                                  ) : (
                                    <span>{author}</span>
                                  )}
                                  {index < authorsList.length - 1 ? ", " : ""}
                                </span>
                              ))}
                              ,{" "}
                              <strong style="color: #1b285c;">
                                "{item.data.title}"
                              </strong>
                            </p>
                            {isViterbi && (
                              <div style="margin: 0; text-align: center; width: 100%;">
                                <a
                                  href="https://github.com/Gigi-G/ViterbiPlanNet"
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  style="color: #2a9d8f; text-decoration: underline; font-weight: 800; font-size: 0.65rem; word-break: break-all;"
                                >
                                  https://github.com/Gigi-G/ViterbiPlanNet
                                </a>
                              </div>
                            )}
                            {projectLink && !isViterbi && (
                              <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                <a
                                  href={projectLink}
                                  target="_blank"
                                  rel="noopener"
                                  class="pill teal-pill"
                                  style="font-size: 0.55rem; padding: 2px 8px; text-decoration: none; line-height: 1;"
                                >
                                  PROJECT PAGE
                                </a>
                              </div>
                            )}
                          </div>
                        );
                      })()}

                      {/* Bullet list of presentations */}
                      <div
                        class="abstracts-list-container"
                        style="padding: 0 0.25rem;"
                      >
                        <ul style="list-style-type: disc; padding-left: 1.1rem; margin: 0; display: flex; flex-direction: column; gap: 0.6rem; font-size: 0.65rem; font-weight: 700; color: #374151; line-height: 1.4;">
                          {item.data.sessions.map((s) => {
                            const isOral = s.type === "Oral";
                            return (
                              <li>
                                <strong
                                  style={`color: ${dateColorMap[s.date]};`}
                                >
                                  {s.date}
                                </strong>{" "}
                                at <strong>{s.time}</strong> -{" "}
                                <span
                                  class={`pill ${isOral ? "teal-pill" : "orange-pill"}`}
                                  style="font-size: 0.5rem; padding: 1px 6px; display: inline-block; vertical-align: middle; margin-right: 0.25rem; line-height: 1.1;"
                                >
                                  {s.type.toUpperCase()}
                                </span>{" "}
                                at{" "}
                                {s.venueUrl ? (
                                  <a
                                    href={s.venueUrl}
                                    target="_blank"
                                    rel="noopener"
                                    style="color: #1b285c; font-weight: 800; text-decoration: underline;"
                                  >
                                    {s.venue}
                                  </a>
                                ) : (
                                  <span>{s.venue}</span>
                                )}{" "}
                                ({s.room}). Presenter:{" "}
                                {(s.presenterIds ?? s.presenters).map(
                                  (pid, i) => {
                                    const name = s.presenters[i] ?? pid;
                                    const id =
                                      (s.presenterIds ?? [])[i] ?? null;
                                    const isTarget =
                                      name === "Luigi Seminara" ||
                                      name === "Antonino Furnari";
                                    return (
                                      <span>
                                        {id ? (
                                          <a
                                            href={`/team/${id}`}
                                            style="color: inherit; text-decoration: underline;"
                                            class={
                                              isTarget
                                                ? "underline font-[900]"
                                                : ""
                                            }
                                          >
                                            {name}
                                          </a>
                                        ) : (
                                          <span
                                            class={
                                              isTarget
                                                ? "underline font-[900]"
                                                : ""
                                            }
                                          >
                                            {name}
                                          </span>
                                        )}
                                        {i < s.presenters.length - 1 ? (
                                          <span>,&nbsp;</span>
                                        ) : null}
                                      </span>
                                    );
                                  },
                                )}
                              </li>
                            );
                          })}
                        </ul>
                      </div>
                    </div>
                  );
                })()}
            </div>
          ));
        })()
      }
    </div>
