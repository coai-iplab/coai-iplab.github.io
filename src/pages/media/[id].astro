                      {(() => {
                        const matchingPub = allPublications.find(
                          (p) =>
                            p.data.title.toLowerCase().trim() ===
                            item.data.title.toLowerCase().trim(),
                        );
                        if (!matchingPub) return null;
                        const authorsList = matchingPub.data.authors
                          .split(/, | and /g)
                          .map((a) => a.trim());
                        const projectLink = matchingPub.data.links?.find(
                          (l) => l.label.toLowerCase() === "project",
                        )?.url;
                        const isViterbi = item.data.title
                          .toLowerCase()
                          .includes("viterbiplannet");
                        return (
                          <div style="margin-bottom: 0.4rem;">
                            <p style="text-align: left; font-size: 0.72rem; font-weight: 700; color: #374151; margin-bottom: 0.15rem; line-height: 1.45;">
