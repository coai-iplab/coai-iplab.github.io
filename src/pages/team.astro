---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { GraduationCap, ExternalLink, UserCircle } from 'lucide-react';
import { COLORS } from '../utils/constants';
import { withBase } from '../lib/url';

const allTeam = await getCollection('team');
const teamMembers = allTeam.filter(m => !m.data.alumni && m.data.category !== 'Past Visitors');
const getRoleRank = (roleStr: string) => {
  const r = roleStr.toLowerCase();
  if (r.includes("postdoc")) return 0;
  if (r.includes("phd")) return 1;
  if (r.includes("msc")) return 2;
  if (r.includes("bsc")) return 3;
  return 4;
};

const getEndYear = (member: any) => {
  const text = `${member.data.years || ''} ${member.data.notes || ''} ${member.data.role || ''}`;
  const matches = Array.from(text.matchAll(/\b(20\d{2})\b/g)).map(m => parseInt(m[1]));
  if (matches.length === 0) return 0;
  return Math.max(...matches);
};

const alumniMembers = allTeam
  .filter(m => m.data.alumni && m.data.category !== 'Past Visitors')
  .sort((a, b) => {
    const rankA = getRoleRank(a.data.role);
    const rankB = getRoleRank(b.data.role);
    if (rankA !== rankB) return rankA - rankB;

    const yearA = getEndYear(a);
    const yearB = getEndYear(b);
    return yearB - yearA;
  });

const pastVisitors = allTeam.filter(m => m.data.category === 'Past Visitors');

const categories = ['Principal Investigator', 'PhD Students', 'Master Students', 'Bachelor Students', 'Collaborators'];

const getAvatar = (seed: string, colorHex: string) => `https://api.dicebear.com/7.x/initials/svg?seed=${encodeURIComponent(seed)}&backgroundColor=${colorHex.replace('#', '')}`;
---

<Layout title="Co-AI Research Group | People">
  <div class="space-y-16 animate-in fade-in slide-in-from-bottom-4 duration-700">
    <header class="max-w-4xl border-b border-gray-200 dark:border-gray-800 pb-8">
      <h2 class="text-5xl font-[900] text-gray-900 dark:text-white mb-4 tracking-tight">People</h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 font-[600] leading-relaxed">
        The researchers, students, and collaborators driving the Co-AI mission.
      </p>
    </header>

    {categories.map(category => {
      const members = teamMembers.filter(m => m.data.category === category);
      if (members.length === 0) return null;

      return (
        <div class="space-y-8">
          <h3 class="text-2xl font-[900] text-gray-800 dark:text-gray-200 uppercase tracking-wide px-2 border-l-4 border-gray-800 dark:border-gray-200">
            {category}
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {members.map((member) => (
              <div class="bg-white dark:bg-gray-900 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-800 overflow-hidden relative group hover:shadow-xl transition-all duration-300">
                <div class="h-32 w-full" style={`background: ${category === 'Principal Investigator' ? `linear-gradient(135deg, ${COLORS.navy}, ${COLORS.teal})` : `linear-gradient(135deg, #f3f4f6, #e5e7eb)`};`}></div>
                <div class="px-8 pb-8">
                  <div class="relative flex justify-between items-end -mt-16 mb-6">
                    <a href={withBase(`/team/${member.id}`)} class="w-28 h-28 bg-white dark:bg-gray-850 rounded-3xl p-1.5 shadow-lg block hover:ring-4 hover:ring-blue-100 transition-all duration-200">
                      <img
                        src={withBase(member.data.profile || member.data.image || getAvatar(member.data.name, member.data.color))}
                        alt={member.data.name}
                        class="w-full h-full rounded-2xl object-cover bg-gray-50 dark:bg-gray-800"
                      />
                    </a>
                  </div>
                  <h3 class="text-2xl font-[900] text-gray-900 dark:text-white mb-1 tracking-tight leading-tight hover:text-blue-600 transition-colors">
                    <a href={withBase(`/team/${member.id}`)}>{member.data.name}</a>
                  </h3>
                  <p class="font-[900] text-sm mb-4 uppercase tracking-wider" style={`color: ${category === 'Principal Investigator' ? COLORS.teal : COLORS.orangeDark};`}>{member.data.role}</p>
                  <div class="flex flex-col gap-2 text-gray-500 dark:text-gray-400 mb-6 text-sm font-[800]">
                    <span class="flex items-center"><GraduationCap size={18} class="mr-2" /> {member.data.affiliation}</span>
                  </div>
                  <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed font-[600] mb-6">
                    {member.body}
                  </p>
                  <div class="flex flex-wrap gap-2">
                    <a href={withBase(`/team/${member.id}`)} class="inline-flex items-center text-sm font-[900] text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 px-4 py-2 rounded-xl transition-colors">
                      View Profile <UserCircle size={16} class="ml-2" />
                    </a>
                    {member.data.link !== '#' && (
                      <a href={member.data.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-sm font-[900] text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 bg-blue-50 dark:bg-blue-950/40 hover:bg-blue-100 dark:hover:bg-blue-900/40 px-4 py-2 rounded-xl transition-colors">
                        Personal Site <ExternalLink size={16} class="ml-2" />
                      </a>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      );
    })}

    {alumniMembers.length > 0 && (
      <div class="space-y-8 pt-8 border-t border-gray-200 dark:border-gray-800">
        <h3 class="text-3xl font-[900] text-gray-900 dark:text-white mb-4 tracking-tight">Alumni</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-gray-200 dark:border-gray-800 text-gray-400 dark:text-gray-500 text-xs font-[900] uppercase tracking-widest">
                <th class="py-4 px-2 w-1/3">Name</th>
                <th class="py-4 px-2 w-2/3">Former Roles</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-gray-800 text-sm font-[600] text-gray-600 dark:text-gray-450">
              {alumniMembers.map((member) => (
                <tr>
                  <td class="py-4 px-2 font-[800] text-gray-900 dark:text-gray-200">
                    {member.data.link !== '#' ? (
                      <a href={member.data.link} target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors inline-flex items-center">
                        {member.data.name} <ExternalLink size={12} class="ml-1" />
                      </a>
                    ) : (
                      member.data.name
                    )}
                  </td>
                  <td class="py-4 px-2 text-gray-500 dark:text-gray-400 font-normal">{member.data.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    {pastVisitors.length > 0 && (
      <div class="space-y-8 pt-8 border-t border-gray-200 dark:border-gray-800">
        <h3 class="text-3xl font-[900] text-gray-900 dark:text-white mb-4 tracking-tight">Past Visitors</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-gray-200 dark:border-gray-800 text-gray-400 dark:text-gray-500 text-xs font-[900] uppercase tracking-widest">
                <th class="py-4 px-2 w-1/3">Name</th>
                <th class="py-4 px-2 w-1/3">Home Institution</th>
                <th class="py-4 px-2 w-1/3">Period</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-gray-800 text-sm font-[600] text-gray-600 dark:text-gray-450">
              {pastVisitors.map((member) => (
                <tr>
                  <td class="py-4 px-2 font-[800] text-gray-900 dark:text-gray-200">
                    {member.data.link !== '#' ? (
                      <a href={member.data.link} target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors inline-flex items-center">
                        {member.data.name} <ExternalLink size={12} class="ml-1" />
                      </a>
                    ) : (
                      member.data.name
                    )}
                  </td>
                  <td class="py-4 px-2">{member.data.affiliation}</td>
                  <td class="py-4 px-2 text-gray-500 dark:text-gray-400 font-normal">{member.data.years}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    {/* Notice for past supervised students prior to group founding */}
    <div class="pt-8 border-t border-gray-200 dark:border-gray-800 text-sm text-gray-500 dark:text-gray-400 font-[600] leading-relaxed">
      <p>
        For a complete list of past supervised students, postdocs, and visiting researchers prior to the group's founding, please see the <a href="https://antoninofurnari.github.io/people/" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-450 hover:underline inline-flex items-center">PI's personal webpage <ExternalLink size={12} class="ml-0.5" /></a>.
      </p>
    </div>
  </div>
</Layout>
