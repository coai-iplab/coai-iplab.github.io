---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import {
  ExternalLink,
  ChevronRight,
  Cpu,
  Award,
  Brain,
  Database,
  ArrowRight,
} from "lucide-react";
import { COLORS } from "../utils/constants";
import { withBase } from "../lib/url";

const order2026 = [
  "viterbiplannet",
  "task graph maximum likelihood estimation",
  "ti-prego",
  "integrating affordances and attention",
  "proskill",
  "ego-extra",
  "online episodic memory visual query localization",
  "exploring multimodal",
];

const publications = (await getCollection("publications"))
  .filter((pub) => pub.data.active !== false)
  .sort((a, b) => {
    // 1. Year comparison (descending)
    const yearDiff = b.data.year.localeCompare(a.data.year);
    if (yearDiff !== 0) return yearDiff;

    // 2. Specific override for 2026
    if (a.data.year === "2026") {
      const titleA = a.data.title.toLowerCase();
      const titleB = b.data.title.toLowerCase();

      const indexA = order2026.findIndex((prefix) => titleA.includes(prefix));
      const indexB = order2026.findIndex((prefix) => titleB.includes(prefix));

      if (indexA !== -1 && indexB !== -1) return indexA - indexB;
      if (indexA !== -1) return -1;
      if (indexB !== -1) return 1;
    }

    // 3. General rule: journals go first, conferences after
    const typeA = a.data.pub_type === "journal" ? 0 : 1;
    const typeB = b.data.pub_type === "journal" ? 0 : 1;
    if (typeA !== typeB) return typeA - typeB;

    // 4. Default fallback: title alphabetical
    return a.data.title.localeCompare(b.data.title);
  })
  .map((pub) => ({
    ...pub,
    data: {
      ...pub.data,
      links:
        pub.data.links?.filter((l) => l.label.toLowerCase() !== "doi") || [],
    },
  }));

const getPrimaryLink = (pub: any) => {
  if (!pub.data.links || pub.data.links.length === 0) return "#";
  const preferred = ["pdf", "project", "paper", "doi"];
  for (const label of preferred) {
    const found = pub.data.links.find((l) =>
      l.label.toLowerCase().includes(label),
    );
    if (found) return found.url;
  }
  return pub.data.links[0].url;
};

const teamMembers = await getCollection("team");

const renderAuthors = (authorsStr: string) => {
  const authors = authorsStr
    .split(/,\s*|\s+and\s+;\s*/)
    .map((a) => a.trim())
    .filter(Boolean);
  return authors.map((author) => {
    let matchedMember: any = null;
    const isLab = teamMembers.some((m) => {
      const r = m.data.name.trim();
      const n1 = r.toLowerCase().replace(/[\.\s-]/g, "");
      const n2 = author.toLowerCase().replace(/[\.\s-]/g, "");
      if (n1 === n2 || n2.includes(n1) || n1.includes(n2)) {
        matchedMember = m;
        return true;
      }

      const rParts = r.split(" ");
      const rLastName = rParts[rParts.length - 1].toLowerCase();
      const aLastName = author.split(" ").pop()?.toLowerCase() || "";

      if (rLastName === aLastName) {
        const rFirstInit = rParts[0][0].toLowerCase();
        if (author[0].toLowerCase() === rFirstInit) {
          matchedMember = m;
          return true;
        }
      }
      return false;
    });

    return { name: author, isLab, id: matchedMember?.id };
  });
};

const getTeaserUrl = (teaser?: string) => {
  if (!teaser) return undefined;
  if (teaser.startsWith("http")) return teaser;
  return withBase(teaser);
};

const getPublicationsByLine = (lineId: string) => {
  return publications.filter((pub) => {
    if (!pub.data.research_line) return false;
    if (Array.isArray(pub.data.research_line)) {
      return pub.data.research_line.includes(lineId);
    }
    return pub.data.research_line === lineId;
  });
};

const researchLines = [
  {
    id: "procedural",
    title: "Procedural Understanding",
    paragraphs: [
      "We study how complex activities unfold over time. Our work develops models for anticipating future actions, representing procedural structure, and reasoning over long-horizon tasks in egocentric and instructional video.",
      "This line of research moves from early action anticipation toward structured procedural reasoning, including task graphs, action segmentation, and planning-aware representations that capture not only what happens next, but how actions are organized into coherent processes.",
    ],
    color: COLORS.teal,
    icon: Cpu,
  },
  {
    id: "skill",
    title: "Skill, Errors, and Assistance",
    paragraphs: [
      "We develop methods that go beyond recognizing actions to evaluate how well they are performed. Our research in this area focuses on mistake detection, skill assessment, and assistive feedback for procedural activities, especially in egocentric settings where understanding the user’s intent and execution is crucial.",
      "The long-term goal is to enable AI systems that can support people during real tasks by identifying deviations, anticipating difficulties, and providing timely, actionable guidance aligned with human autonomy.",
    ],
    color: COLORS.orangeDark,
    icon: Award,
  },
  {
    id: "memory",
    title: "Memory and Streaming Intelligence",
    paragraphs: [
      "We investigate how AI systems can observe continuously, remember relevant past events, and reason over long streams of egocentric experience. This includes streaming perception, episodic memory, and multimodal question answering over events that unfold over time.",
      "Our aim is to build systems that do not simply process isolated frames or clips, but maintain a compact and useful representation of ongoing experience, enabling context-aware reasoning and support in always-on wearable scenarios.",
    ],
    color: COLORS.purple,
    icon: Brain,
  },
  {
    id: "datasets",
    title: "Datasets and Benchmarks",
    paragraphs: [
      "We contribute datasets, benchmarks, and evaluation protocols that help shape research in egocentric and procedural video understanding. These resources provide the community with challenging real-world scenarios for studying action recognition, anticipation, skill understanding, memory, and assistance.",
      "By building shared benchmarks, we aim to support reproducible progress and enable new research directions at the intersection of first-person vision, multimodal learning, and human-centred AI.",
    ],
    color: COLORS.navy,
    icon: Database,
  },
];
---

<Layout title="Co-AI Research Group | Research">
  <div
    class="space-y-16 animate-in fade-in slide-in-from-bottom-4 duration-700 max-w-5xl"
  >
    {/* Page Header */}
    <div class="border-b border-gray-200 dark:border-gray-800 pb-10">
      <h1
        class="text-5xl font-[900] text-gray-900 dark:text-white mb-6 tracking-tight"
      >
        Research Lines
      </h1>

      <div
        class="space-y-6 max-w-4xl text-lg md:text-xl text-gray-600 dark:text-gray-300 leading-relaxed font-[600]"
      >
        <p>
          Our research focuses on visual intelligence for Human-AI
          collaboration. We study how AI systems can perceive, understand, and
          anticipate what people are doing from first-person and multi-view
          observations, with the goal of supporting human activity through
          memory, skill-aware analysis, and timely assistance.
        </p>
        <p>We focus on the following themes:</p>
      </div>

      {/* Jump Links Nav */}
      <div class="mt-8 flex flex-wrap gap-3">
        {
          researchLines.map((line) => {
            const Icon = line.icon;
            return (
              <a
                href={`#${line.id}`}
                class="inline-flex items-center gap-2 px-4 py-2 rounded-2xl text-xs font-[900] border border-transparent dark:border-gray-800 transition-all duration-300 hover:shadow-sm"
                style={`border-color: ${line.color}30; background-color: ${line.color}05; color: ${line.color};`}
              >
                <Icon size={14} />
                {line.title}
              </a>
            );
          })
        }
      </div>
    </div>

    {/* Research Lines Sections */}
    <div class="space-y-20">
      {
        researchLines.map((line) => {
          const Icon = line.icon;
          const linePublications = getPublicationsByLine(line.id);
          const publicationsWithTeaser = linePublications.filter(
            (pub) => pub.data.teaser,
          );

          return (
            <section
              id={line.id}
              class="scroll-mt-24 space-y-8 bg-white dark:bg-gray-900 p-8 md:p-10 rounded-3xl border border-gray-100 dark:border-gray-800 shadow-sm transition-colors duration-200"
            >
              {/* Section Header */}
              <div class="border-b border-gray-100 dark:border-gray-800 pb-4 flex items-center gap-3">
                <div
                  class="w-12 h-12 rounded-2xl flex items-center justify-center animate-pulse"
                  style={`background-color: ${line.color}15; color: ${line.color};`}
                >
                  <Icon size={24} />
                </div>
                <h2 class="text-3xl font-[900] text-gray-900 dark:text-white tracking-tight">
                  {line.title}
                </h2>
              </div>

              {/* Teaser Gallery */}
              {publicationsWithTeaser.length > 0 && (
                <div class="space-y-3">
                  <h3 class="text-xs font-[900] uppercase tracking-widest text-gray-400 dark:text-gray-500">
                    Featured Work Gallery
                  </h3>
                  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
                    {publicationsWithTeaser.map((pub) => {
                      const teaserUrl = getTeaserUrl(pub.data.teaser);
                      return (
                        <a
                          href={withBase(`/research/${pub.id}`)}
                          class="group block relative rounded-2xl overflow-hidden bg-gray-50 dark:bg-gray-850 border border-gray-100 dark:border-gray-800 aspect-video flex items-center justify-center p-2 hover:shadow-md hover:border-gray-250 dark:hover:border-gray-700 transition-all duration-300"
                          title={pub.data.title}
                        >
                          <img
                            src={teaserUrl}
                            alt={pub.data.title}
                            class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-300"
                          />
                        </a>
                      );
                    })}
                  </div>
                </div>
              )}

              {/* Description Paragraphs */}
              <div class="space-y-4 text-gray-600 dark:text-gray-300 leading-relaxed font-[600] text-base md:text-lg max-w-4xl">
                {line.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
              </div>

              {/* Flat Publications List (Without Teasers) */}
              <div class="pt-6 border-t border-gray-100 dark:border-gray-850 space-y-4">
                <h3 class="text-xs font-[900] uppercase tracking-widest text-gray-400 dark:text-gray-500">
                  Linked Publications
                </h3>
                {linePublications.length > 0 ? (
                  <div class="divide-y divide-gray-100 dark:divide-gray-850 animate-in fade-in">
                    {linePublications.map((pub) => {
                      return (
                        <div class="py-4 first:pt-0 last:pb-0 group flex flex-col gap-2">
                          <div class="flex flex-wrap items-center gap-2">
                            <span
                              class="text-[9px] font-[900] px-2 py-0.5 rounded-full uppercase tracking-wider font-mono"
                              style={`background-color: ${pub.data.pub_type === "journal" ? COLORS.purple : COLORS.teal}15; color: ${pub.data.pub_type === "journal" ? COLORS.purple : COLORS.teal};`}
                            >
                              {pub.data.pub_type}
                            </span>
                            <span class="text-[9px] font-[900] px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-850 text-gray-500 dark:text-gray-400 font-mono">
                              {pub.data.year}
                            </span>
                            {pub.data.award &&
                              pub.data.award
                                .split(";")
                                .map((aw) => (
                                  <span class="text-[9px] font-[900] px-2 py-0.5 rounded-full bg-amber-50 dark:bg-amber-950/20 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-900/30 uppercase tracking-wider flex items-center gap-1">
                                    🏆 {aw.trim()}
                                  </span>
                                ))}
                          </div>

                          <a
                            href={withBase(`/research/${pub.id}`)}
                            class="text-lg font-[900] text-gray-900 dark:text-white group-hover:text-blue-700 dark:group-hover:text-blue-400 transition-colors leading-tight tracking-tight"
                          >
                            {pub.data.title}
                          </a>

                          <p class="text-gray-700 dark:text-gray-300 text-xs font-[800]">
                            {renderAuthors(pub.data.authors).map(
                              (author, index, arr) => (
                                <span>
                                  {author.isLab ? (
                                    <a
                                      href={withBase(`/team/${author.id}`)}
                                      class="underline decoration-gray-400 dark:decoration-gray-650 underline-offset-2 font-[800] hover:text-blue-700 dark:hover:text-blue-400 transition-colors"
                                    >
                                      {author.name}
                                    </a>
                                  ) : (
                                    <span>{author.name}</span>
                                  )}
                                  {index < arr.length - 1 ? ", " : ""}
                                </span>
                              ),
                            )}
                          </p>

                          <div class="flex flex-wrap items-center justify-between gap-4">
                            <p class="text-gray-500 dark:text-gray-400 text-[11px] italic font-[600]">
                              {pub.data.venue}
                            </p>

                            <div class="flex flex-wrap gap-2 items-center">
                              {pub.data.links && pub.data.links.length > 0 && (
                                <div class="flex flex-wrap gap-1.5">
                                  {pub.data.links.map((l) => (
                                    <a
                                      href={l.url}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      class="inline-flex items-center text-[10px] font-[900] text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/40 px-2 py-1 rounded-lg transition-colors"
                                    >
                                      {l.label}{" "}
                                      <ExternalLink size={10} class="ml-0.5" />
                                    </a>
                                  ))}
                                </div>
                              )}
                              {pub.data.bibtex && (
                                <>
                                  <button
                                    onclick={`document.getElementById('bibtex-dialog-${pub.id}').showModal()`}
                                    class="inline-flex items-center text-[10px] font-[900] text-teal-600 dark:text-teal-400 bg-teal-50 dark:bg-teal-950/40 hover:bg-teal-100 dark:hover:bg-teal-900/40 px-2 py-1 rounded-lg transition-colors cursor-pointer"
                                  >
                                    BibTeX
                                  </button>
                                  <dialog
                                    id={`bibtex-dialog-${pub.id}`}
                                    class="rounded-3xl border border-gray-100 dark:border-gray-800 p-0 shadow-2xl max-w-2xl w-full backdrop:bg-black/50 overflow-hidden mx-auto my-auto fixed inset-0 bg-white dark:bg-gray-900"
                                    onclick="event.target === this && this.close()"
                                  >
                                    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900">
                                      <span class="text-xs font-[900] uppercase tracking-widest text-gray-400 dark:text-gray-500">
                                        BibTeX Citation
                                      </span>
                                      <button
                                        onclick="this.closest('dialog').close()"
                                        class="text-gray-400 hover:text-gray-900 dark:text-gray-500 dark:hover:text-white transition-colors text-2xl font-[900] cursor-pointer"
                                      >
                                        &times;
                                      </button>
                                    </div>
                                    <pre class="p-6 text-xs font-mono text-gray-700 dark:text-gray-300 bg-gray-50 dark:bg-gray-950 overflow-x-auto whitespace-pre leading-relaxed">
                                      {pub.data.bibtex}
                                    </pre>
                                    <div class="px-6 py-4 border-t border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900 flex justify-end">
                                      <button
                                        onclick="navigator.clipboard.writeText(this.closest('dialog').querySelector('pre').textContent); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy', 1500)"
                                        class="px-4 py-2 bg-blue-50 hover:bg-blue-100 dark:bg-blue-950/40 dark:hover:bg-blue-900/40 text-blue-600 dark:text-blue-400 rounded-xl font-[900] text-xs uppercase tracking-wider transition-colors cursor-pointer"
                                      >
                                        Copy
                                      </button>
                                    </div>
                                  </dialog>
                                </>
                              )}
                            </div>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                ) : (
                  <p class="text-sm font-[600] text-gray-400 dark:text-gray-500 italic">
                    No publications linked to this research line.
                  </p>
                )}
              </div>
            </section>
          );
        })
      }
    </div>

    {/* Call to Action: Full publications page */}
    <div
      class="bg-gray-50 dark:bg-gray-900/50 rounded-3xl p-8 border border-gray-100 dark:border-gray-850 flex flex-col md:flex-row items-center justify-between gap-6 hover:shadow-sm transition-all duration-300"
    >
      <div class="space-y-2">
        <h3
          class="text-2xl font-[900] text-gray-900 dark:text-white tracking-tight"
        >
          Looking for the full publications list?
        </h3>
        <p class="text-gray-600 dark:text-gray-300 font-[600]">
          Explore our complete catalog of journal articles, conference papers,
          patents, and datasets.
        </p>
      </div>
      <a
        href={withBase("/publications")}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-[#1b285c] dark:bg-gray-800 text-white hover:bg-opacity-90 font-[900] text-sm tracking-wide uppercase transition-colors"
      >
        View All Publications
        <ArrowRight size={16} />
      </a>
    </div>
  </div>
</Layout>
