---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Award, FileText, Megaphone, Calendar, ExternalLink } from 'lucide-react';
import { COLORS } from '../utils/constants';

const rawNewsItems = (await getCollection('news')).sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const newsItems = await Promise.all(
  rawNewsItems.map(async (item) => {
    const { Content } = await render(item);
    return { item, Content, talk: null, isTalk: false };
  })
);

const allEngagements = await getCollection('engagements');
const upcomingEngagements = allEngagements
  .filter(e => e.data.upcoming)
  .sort((a, b) => {
    const numA = parseInt(a.id.replace('talk-', ''));
    const numB = parseInt(b.id.replace('talk-', ''));
    if (isNaN(numA) && isNaN(numB)) return a.id.localeCompare(b.id);
    if (isNaN(numA)) return 1;
    if (isNaN(numB)) return -1;
    if (numA !== numB) return numA - numB;
    return a.id.localeCompare(b.id);
  });
const upcomingTalksAsNews = await Promise.all(
  upcomingEngagements.map(async (talk) => {
    const { Content } = await render(talk);
    return { talk, Content, item: null, isTalk: true };
  })
);

// Prepend upcoming talks on top of the news list
const combinedFeed = [...upcomingTalksAsNews, ...newsItems];

const homeEntry = await getEntry('home', 'index');
const homeData = homeEntry ? homeEntry.data : {
  title: "Advancing Embodied <br/>Human-AI Symbiosis",
  description: "We explore the intersection of Computer Vision, Machine Learning, and wearable computing to build systems that truly understand real-world procedural activities."
};

const ICONS: Record<string, any> = {
  Award, FileText, Megaphone, Calendar
};

const formatDate = (dateStr: string) => {
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return dateStr;
  return d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
};
---

<Layout title="Co-AI Research Group | Home">
  <div class="space-y-16 animate-in fade-in slide-in-from-bottom-4 duration-700">
    {/* Hero Section */}
    <header class="max-w-4xl space-y-6 pt-4">
      <h1 class="text-3xl md:text-5xl font-[900] tracking-tight text-gray-900 dark:text-white leading-[1.1]" set:html={homeData.title}>
      </h1>
      <p class="text-lg md:text-xl text-gray-600 dark:text-gray-300 leading-relaxed font-[600] max-w-3xl" set:html={homeData.description}>
      </p>
    </header>

    {/* Prospective Visiting PhD Students Card */}
    <div class="border border-green-300 dark:border-green-900/30 bg-green-50 dark:bg-green-950/10 rounded-2xl p-6 md:p-8 my-6 flex flex-col gap-4 shadow-sm" style="border-width:2px;">
      <div class="flex items-center gap-2 mb-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="text-green-600 dark:text-green-400"><circle cx="12" cy="12" r="10" stroke-width="2"/><path stroke-width="2" d="M12 8v4m0 4h.01"/></svg>
        <span class="font-bold text-lg md:text-xl text-green-900 dark:text-green-300">Prospective Visiting PhD Students</span>
      </div>
      <div class="text-gray-800 dark:text-gray-300 text-base md:text-lg">
        Interested in joining our group as a visiting PhD student? We welcome motivated candidates from around the world to collaborate and join our research environment in Catania.
      </div>
      <div>
        <a href="/contact" class="inline-block px-5 py-2 rounded-md bg-green-600 text-white font-bold text-base tracking-wide shadow hover:bg-green-700 transition-colors">GO TO CONTACT PAGE</a>
      </div>
    </div>

    {/* Link to CVPR 2026 highlights media card */}
    <div class="relative overflow-hidden rounded-3xl p-6 md:p-8 bg-gradient-to-r from-[#1b285c] via-[#2a9d8f] to-[#e86f38] text-white shadow-lg hover:shadow-xl transition-all duration-300 group">
      <div class="absolute inset-0 bg-black/10 opacity-60 group-hover:opacity-40 transition-opacity"></div>
      <div class="relative flex flex-col md:flex-row md:items-center justify-between gap-6 z-10">
        <div>
          <h3 class="text-2xl md:text-3xl font-[900] tracking-tight text-white mb-2">CO-AI AT CVPR 2026</h3>
          <p class="text-white/80 font-[600] text-sm md:text-base max-w-xl leading-relaxed">
            Discover our group's accepted papers, invited talks, workshop co-organizations, and full schedule inside our highlights card.
          </p>
        </div>
        <a href="/media/cvpr2026" class="inline-flex items-center justify-center bg-white text-[#1b285c] hover:bg-opacity-90 font-[900] px-6 py-3 rounded-2xl shadow-md hover:shadow-lg hover:scale-[1.02] active:scale-95 transition-all self-start md:self-center" style="white-space: nowrap;">
          View Research Highlights <ExternalLink size={18} class="ml-2" />
        </a>
      </div>
    </div>

    {/* News Section */}
    <div class="space-y-8">
      <div class="border-b border-gray-200 dark:border-gray-800 pb-4">
        <h2 class="text-3xl font-[900] text-gray-900 dark:text-white tracking-tight flex items-center gap-2">
          <Megaphone size={28} class="text-gray-400" /> Latest News & Events
        </h2>
      </div>
      
      <div class="space-y-6 max-w-4xl">
        {combinedFeed.map(({ item, talk, Content, isTalk }) => {
          if (isTalk && talk) {
            const speakers = Array.isArray(talk.data.speaker) ? talk.data.speaker : [talk.data.speaker];
            const speakerIds = Array.isArray(talk.data.speakerId) ? talk.data.speakerId : [talk.data.speakerId];
            const speakerList = speakers.map((name, idx) => ({
              name,
              id: speakerIds[idx] || speakerIds[0]
            }));

            return (
              <div class="bg-gradient-to-br from-red-50/30 to-orange-50/30 dark:from-red-950/10 dark:to-orange-950/10 p-8 rounded-3xl border border-red-100 dark:border-red-900/20 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
                <div class="absolute top-0 right-0 text-white text-[10px] font-[900] uppercase tracking-widest px-4 py-1.5 rounded-bl-2xl" style="background-color: #e86f38;">
                  Upcoming
                </div>
                <div class="flex flex-col sm:flex-row gap-6">
                  <div class="flex-shrink-0 w-16 h-16 rounded-2xl flex items-center justify-center text-white shadow-md" style="background-color: #e86f38;">
                    <Calendar size={28} />
                  </div>
                  <div class="flex-grow">
                    <div class="flex items-center gap-3 mb-2">
                      <span class="text-sm font-[900] font-mono" style="color: #e86f38;">{talk.data.date}</span>
                      <span class="px-3 py-1 rounded-full text-xs font-[800] uppercase tracking-wider" style="background-color: #e86f3815; color: #e86f38;">
                        {talk.data.type}
                      </span>
                    </div>
                    <h3 class="text-2xl md:text-3xl font-[900] text-gray-900 dark:text-white mb-2 leading-tight">{talk.data.title}</h3>
                    <p class="text-gray-700 dark:text-gray-300 font-[800] text-lg mb-2">{talk.data.venue}</p>
                    {!talk.data.hideSpeakers && (
                      <p class="text-gray-500 dark:text-gray-400 text-sm font-[700] mb-4">
                        {(talk.data.type === 'Oral & Poster Presentations' || talk.data.type === 'Poster Presentations') && 'Authors: '}{speakerList.map((sp, idx) => (
                          <span><a href={sp.id.startsWith('http') ? sp.id : `/team/${sp.id}`} class={`hover:underline font-[800] ${(sp.name === 'Luigi Seminara' || sp.name === 'Antonino Furnari') ? 'underline' : ''}`} style="color: #e86f38;">{sp.name}</a>{idx < speakerList.length - 1 ? (speakerList.length > 2 ? ', ' : ' & ') : ''}</span>
                        ))}
                      </p>
                    )}
                    
                    {/* Talk Body Content */}
                    <div class="text-gray-600 dark:text-gray-400 font-[500] leading-relaxed mb-4 news-body prose prose-sm max-w-none">
                      <Content />
                    </div>

                    <div class="flex flex-wrap gap-2">
                      {talk.data.paperUrl && (
                        <a href={talk.data.paperUrl} class="inline-flex items-center text-sm font-[900] px-4 py-2 rounded-xl transition-colors" style="color: #e86f38; background-color: #e86f3815;">
                          Paper Page <ExternalLink size={16} class="ml-2" />
                        </a>
                      )}
                      {talk.data.slides && (
                        <a href={talk.data.slides} target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-sm font-[900] px-4 py-2 rounded-xl transition-colors" style="color: #e86f38; background-color: #e86f3815;">
                          Slides <ExternalLink size={16} class="ml-2" />
                        </a>
                      )}
                      {talk.data.mediaCard && (
                        <a href={`/media/${talk.data.mediaCard}`} class="inline-block px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-300 font-[800] text-xs uppercase tracking-wider hover:bg-blue-100 transition-colors" target="_blank" rel="noopener noreferrer">
                          See All CVPR 2026 Research Highlight
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            );
          } else if (item) {
            const IconComponent = ICONS[item.data.icon] || Megaphone;
            return (
              <div class="p-8 rounded-3xl border flex flex-col sm:flex-row gap-6 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden bg-white dark:bg-gray-900 border-gray-100 dark:border-gray-800">
                <div class="flex-shrink-0 w-16 h-16 rounded-2xl flex items-center justify-center" style={`background-color: ${item.data.color || COLORS.teal}15; color: ${item.data.color || COLORS.teal};`}>
                  {IconComponent && <IconComponent size={28} />}
                </div>
                <div class="flex-grow">
                  <div class="flex items-center gap-3 mb-2">
                    <span class="text-sm font-[900] text-gray-400 dark:text-gray-500 uppercase tracking-wider">{formatDate(item.data.date)}</span>
                    <span class="px-3 py-1 rounded-full text-xs font-[800] uppercase tracking-wider" style={`background-color: ${item.data.color || COLORS.teal}15; color: ${item.data.color || COLORS.teal};`}>
                      {item.data.type}
                    </span>
                  </div>
                  <h3 class="text-2xl font-[900] text-gray-900 dark:text-white mb-2 leading-tight">{item.data.title}</h3>
                  <div class="text-gray-600 dark:text-gray-400 font-[600] leading-relaxed space-y-2 news-body">
                    <Content />
                  </div>
                </div>
              </div>
            );
          }
        })}
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  .news-body a {
    color: #1b285c;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 800;
    transition: color 0.2s ease;
  }
  .news-body a:hover {
    color: #2a9d8f;
  }
  .news-body ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .news-body li {
    margin-bottom: 0.5rem;
  }
  .news-body table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }
  .news-body th {
    font-weight: 800;
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 2px solid #e5e7eb;
    color: #374151;
  }
  .news-body td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #f3f4f6;
    color: #4b5563;
  }
  .news-body th:nth-child(1), .news-body td:nth-child(1) { width: 25%; }
  .news-body th:nth-child(2), .news-body td:nth-child(2) { width: 25%; }
  .news-body th:nth-child(3), .news-body td:nth-child(3) { width: 20%; }
  .news-body th:nth-child(4), .news-body td:nth-child(4) { width: 30%; }
  .news-body tr:hover td {
    background-color: #f9fafb;
  }
</style>
