---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { ExternalLink, ChevronRight } from 'lucide-react';
import { COLORS } from '../utils/constants';

const publications = (await getCollection('publications'))
  .filter(pub => pub.data.active !== false)
  .sort((a, b) => b.data.year.localeCompare(a.data.year))
  .map(pub => ({
    ...pub,
    data: {
      ...pub.data,
      links: pub.data.links?.filter(l => l.label.toLowerCase() !== 'doi') || []
    }
  }));

const publicationsByYear: Record<string, typeof publications> = {};
publications.forEach(pub => {
  const y = pub.data.year;
  if (!publicationsByYear[y]) {
    publicationsByYear[y] = [];
  }
  publicationsByYear[y].push(pub);
});
const years = Object.keys(publicationsByYear).sort((a, b) => b.localeCompare(a));

const teamMembers = await getCollection('team');
const labResearchers = teamMembers.map(m => m.data.name.trim());

const renderAuthors = (authorsStr: string) => {
  const authors = authorsStr.split(/,\s*|\s+and\s+;\s*/).map(a => a.trim()).filter(Boolean);
  return authors.map(author => {
    let matchedMember: any = null;
    const isLab = teamMembers.some(m => {
      const r = m.data.name.trim();
      const n1 = r.toLowerCase().replace(/[\.\s-]/g, '');
      const n2 = author.toLowerCase().replace(/[\.\s-]/g, '');
      if (n1 === n2 || n2.includes(n1) || n1.includes(n2)) {
        matchedMember = m;
        return true;
      }
      
      const rParts = r.split(' ');
      const rLastName = rParts[rParts.length - 1].toLowerCase();
      const aLastName = author.split(' ').pop()?.toLowerCase() || '';
      
      if (rLastName === aLastName) {
        const rFirstInit = rParts[0][0].toLowerCase();
        if (author[0].toLowerCase() === rFirstInit) {
          matchedMember = m;
          return true;
        }
      }
      return false;
    });
    
    return { name: author, isLab, id: matchedMember?.id };
  });
};

const getPrimaryLink = (pub: any) => {
  if (!pub.data.links || pub.data.links.length === 0) return '#';
  const preferred = ['pdf', 'project', 'paper', 'doi'];
  for (const label of preferred) {
    const found = pub.data.links.find(l => l.label.toLowerCase().includes(label));
    if (found) return found.url;
  }
  return pub.data.links[0].url;
};

const getTeaserUrl = (teaser?: string) => {
  if (!teaser) return undefined;
  if (teaser.startsWith('http')) return teaser;
  return teaser;
};
---

<Layout title="Co-AI Research Group | Publications">
  <div class="space-y-12 animate-in fade-in slide-in-from-bottom-4 duration-700 max-w-5xl">
    <div class="border-b border-gray-200 pb-8">
      <h2 class="text-5xl font-[900] text-gray-900 mb-4 tracking-tight">Selected Publications</h2>
      <p class="text-xl text-gray-600 font-[600]">Core contributions to First-Person Vision and Action Anticipation.</p>
    </div>
    <div class="space-y-16">
      {years.map((year) => (
        <div class="space-y-8">
          <h3 class="text-3xl font-[900] text-gray-800 border-b border-gray-200 pb-4 tracking-tight flex items-center gap-3">
            <span class="w-2.5 h-8 rounded-full" style={`background-color: ${COLORS.navy};`}></span>
            {year}
          </h3>
          <div class="space-y-6">
            {publicationsByYear[year].map((pub) => {
              const primaryLink = getPrimaryLink(pub);
              const teaserUrl = getTeaserUrl(pub.data.teaser);
              return (
                <div class="bg-white p-6 md:p-8 rounded-3xl border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300 group flex flex-col md:flex-row gap-6">
                  <div class="flex-grow">
                    <div class="flex flex-wrap items-center gap-2 mb-3">
                       <span class="text-xs font-[900] px-4 py-1.5 rounded-full uppercase tracking-widest" style={`background-color: ${pub.data.pub_type === 'journal' ? COLORS.purple : COLORS.teal}15; color: ${pub.data.pub_type === 'journal' ? COLORS.purple : COLORS.teal};`}>
                         {pub.data.pub_type}
                       </span>
                       <span class="text-xs font-[900] px-3 py-1.5 rounded-full bg-gray-100 text-gray-500 font-mono">
                         {pub.data.year}
                       </span>
                        {pub.data.award && pub.data.award.split(';').map(aw => (
                          <span class="text-xs font-[900] px-3 py-1.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200 uppercase tracking-wider flex items-center gap-1">
                            🏆 {aw.trim()}
                          </span>
                        ))}
                    </div>
                    <a href={`/research/${pub.id}`} class="text-2xl font-[900] text-gray-900 group-hover:text-blue-700 transition-colors block mb-3 leading-tight tracking-tight">{pub.data.title}</a>
                    <p class="text-gray-700 font-[800] mb-2">
                      {renderAuthors(pub.data.authors).map((author, index, arr) => (
                        <span>
                          {author.isLab ? (
                            <a href={`/team/${author.id}`} class="underline decoration-gray-400 underline-offset-4 font-[800] hover:text-blue-700 transition-colors">
                              {author.name}
                            </a>
                          ) : (
                            <span>{author.name}</span>
                          )}
                          {index < arr.length - 1 ? ', ' : ''}
                        </span>
                      ))}
                    </p>
                    <p class="text-gray-500 text-sm italic font-[600] mb-4">{pub.data.venue}</p>

                    {teaserUrl && (
                      <div class="my-4 max-w-lg rounded-2xl overflow-hidden flex items-center justify-start">
                        <img 
                          src={teaserUrl} 
                          alt={pub.data.title} 
                          class="max-w-full max-h-48 object-contain"
                        />
                      </div>
                    )}
                    
                    <div class="flex flex-wrap gap-2 items-center">
                      {pub.data.links && pub.data.links.length > 0 && (
                        <div class="flex flex-wrap gap-2">
                          {pub.data.links.map(l => (
                            <a href={l.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-xs font-[900] text-blue-600 hover:text-blue-800 bg-blue-50 px-3 py-1.5 rounded-xl transition-colors">
                              {l.label} <ExternalLink size={12} class="ml-1" />
                            </a>
                          ))}
                        </div>
                      )}
                      {pub.data.bibtex && (
                        <>
                          <button 
                            onclick={`document.getElementById('bibtex-dialog-${pub.id}').showModal()`}
                            class="inline-flex items-center text-xs font-[900] text-teal-600 hover:text-teal-800 bg-teal-50 px-3 py-1.5 rounded-xl transition-colors cursor-pointer"
                          >
                            BibTeX
                          </button>
                          <dialog 
                            id={`bibtex-dialog-${pub.id}`}
                            class="rounded-3xl border border-gray-100 p-0 shadow-2xl max-w-2xl w-full backdrop:bg-black/50 overflow-hidden mx-auto my-auto fixed inset-0"
                            onclick="event.target === this && this.close()"
                          >
                            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 bg-white">
                              <span class="text-xs font-[900] uppercase tracking-widest text-gray-400">BibTeX Citation</span>
                              <button onclick="this.closest('dialog').close()" class="text-gray-400 hover:text-gray-900 transition-colors text-2xl font-[900] cursor-pointer">&times;</button>
                            </div>
                            <pre class="p-6 text-xs font-mono text-gray-700 bg-gray-50 overflow-x-auto whitespace-pre leading-relaxed">{pub.data.bibtex}</pre>
                            <div class="px-6 py-4 border-t border-gray-100 bg-white flex justify-end">
                              <button 
                                onclick="navigator.clipboard.writeText(this.closest('dialog').querySelector('pre').textContent); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy', 1500)"
                                class="px-4 py-2 bg-blue-50 hover:bg-blue-100 text-blue-600 rounded-xl font-[900] text-xs uppercase tracking-wider transition-colors cursor-pointer"
                              >
                                Copy
                              </button>
                            </div>
                          </dialog>
                        </>
                      )}
                    </div>

                    {pub.data.related && (() => {
                      const relatedEntry = publications.find(p => p.id.toLowerCase() === pub.data.related.toLowerCase());
                      if (!relatedEntry) return null;
                      return (
                        <div class="mt-4 p-4 bg-gray-50/75 border border-gray-100 rounded-2xl flex flex-col md:flex-row gap-4 items-start md:items-center justify-between">
                          <div class="space-y-1">
                            <div class="flex items-center gap-2">
                              <span class="text-[9px] font-[900] px-2.5 py-0.5 rounded-full uppercase tracking-wider font-mono" style={`background-color: ${relatedEntry.data.pub_type === 'journal' ? COLORS.purple : COLORS.teal}15; color: ${relatedEntry.data.pub_type === 'journal' ? COLORS.purple : COLORS.teal};`}>
                                {relatedEntry.data.pub_type === 'journal' ? 'Journal Version' : 'Conference Version'}
                              </span>
                              <span class="text-[10px] font-[900] px-2 py-0.5 rounded-full bg-gray-200 text-gray-500 font-mono">
                                {relatedEntry.data.year}
                              </span>
                            </div>
                            <a href={`/research/${relatedEntry.id}`} class="text-sm font-[900] text-gray-800 hover:text-blue-700 transition-colors block leading-snug">
                              {relatedEntry.data.title}
                            </a>
                          </div>
                          {relatedEntry.data.links && relatedEntry.data.links.length > 0 && (
                            <div class="flex flex-wrap gap-2 flex-shrink-0">
                              {relatedEntry.data.links.map(l => (
                                <a href={l.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-[10px] font-[900] text-blue-600 hover:text-blue-800 bg-blue-50/70 px-2.5 py-1 rounded-lg transition-colors">
                                  {l.label} <ExternalLink size={10} class="ml-0.5" />
                                </a>
                              ))}
                            </div>
                          )}
                        </div>
                      );
                    })()}
                  </div>
                  <a href={`/research/${pub.id}`} class="text-gray-300 hover:text-gray-900 self-start md:self-center p-2 hidden md:block transition-colors">
                    <ChevronRight size={32} />
                  </a>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
