---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { ArrowLeft, ExternalLink } from "lucide-react";

const publications = await getCollection("publications");

const findPub = (id: string) => publications.find((p) => p.id.toLowerCase() === id.toLowerCase());

const egometas = findPub("santosvillafranca2026egometas");
const egostream = findPub("forte2026egostream");
const viterbi = findPub("Seminara2026ViterbiPlanNet");
const recipe = findPub("seminara2026recipe");

const papers = [
  {
    emoji: "🥽",
    title: "Ego-METAS",
    subtitle: "Multimodal Energy-Efficient Temporal Action Segmentation",
    focus: "Multimodal efficient sensing and energy-aware policies for wearable devices.",
    overview:
      "This work introduces a benchmark addressing the \"Infinite Scaling Assumption\" by evaluating how egocentric online models perform under strict energy budgets (e.g., 20mW).",
    finding:
      "Exhaustive processing heavily drains batteries, whereas greedy and learned policies for framerate reduction provide a more sustainable approach to continuous sensing.",
    pub: egometas,
    pubId: "santosvillafranca2026egometas",
    accentColor: "#2a9d8f",
    bgColor: "#2a9d8f12",
    borderColor: "#2a9d8f30",
    theme: "Cognitive Economy",
    themeIcon: "⚡",
  },
  {
    emoji: "🧠",
    title: "EgoStream",
    subtitle: "Streaming Episodic Memory in Egocentric Vision",
    focus:
      "A diagnostic benchmark for assessing episodic memory in AI across various temporal recall regimes, from instant (0s) to ultra-long (>8h).",
    overview:
      "We explore memory management strategies like pruning, merging, and offloading within a fixed memory budget to maintain continuous video streams.",
    finding:
      "Pruning-based memory management generally outperforms merging and offloading, though offloading recovers performance in ultra-long recall scenarios.",
    pub: egostream,
    pubId: "forte2026egostream",
    accentColor: "#7b5b9e",
    bgColor: "#7b5b9e12",
    borderColor: "#7b5b9e30",
    theme: "Cognitive Economy",
    themeIcon: "⚡",
  },
  {
    emoji: "📊",
    title: "ViterbiPlanNet",
    subtitle: "Injecting Procedural Knowledge for Video Planning",
    focus:
      "Using procedural graphs as cognitive support to inject knowledge into the learning process via a Differentiable Viterbi Layer.",
    overview:
      "This method addresses cognitive offloading by allowing base models to rely on structured graphs rather than memorizing full procedures.",
    finding:
      "Achieves state-of-the-art success rates with an order of magnitude fewer parameters (e.g., 5.58M) and demonstrates strong sample efficiency and cross-horizon generalization.",
    pub: viterbi,
    pubId: "Seminara2026ViterbiPlanNet",
    accentColor: "#e86f38",
    bgColor: "#e86f3812",
    borderColor: "#e86f3830",
    theme: "Knowledge Grounding",
    themeIcon: "🔗",
    award: "CVPR 2026 Highlight · Top 14%",
  },
  {
    emoji: "🛠️",
    title: "RECIPE",
    subtitle: "Procedural Planning via Grounding in Instructional Video",
    focus:
      "A dual-input configuration utilizing specialized procedural models to plan tasks from visual and textual histories.",
    overview:
      "The framework explores grounding as verification, utilizing noisy video corpora to build resilience against weak supervision and procedural diversity.",
    finding:
      "Meaningfully improves macro accuracy over supervised fine-tuning, especially in zero-shot environments.",
    pub: recipe,
    pubId: "seminara2026recipe",
    accentColor: "#f4a24c",
    bgColor: "#f4a24c12",
    borderColor: "#f4a24c30",
    theme: "Knowledge Grounding",
    themeIcon: "🔗",
  },
];
---

<Layout title="VITA Workshop Talk Preview | Co-AI Research Group">
  <div class="max-w-4xl mx-auto space-y-10 animate-in fade-in slide-in-from-bottom-4 duration-700">

    <!-- Back link -->
    <a href="/engagement" class="inline-flex items-center gap-2 text-sm font-[800] text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors group">
      <ArrowLeft size={16} class="group-hover:-translate-x-1 transition-transform" />
      Back to Public Engagement
    </a>

    <!-- Hero / Header -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#1b285c] via-[#2a4a8f] to-[#1b285c] text-white p-8 md:p-12 shadow-xl">
      <div class="relative z-10">
        <!-- Event badge -->
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="inline-flex items-center gap-1.5 text-xs font-[900] uppercase tracking-widest px-3 py-1.5 rounded-full bg-white/10 border border-white/20">
            🎙️ Invited Talk
          </span>
          <span class="inline-flex items-center gap-1.5 text-xs font-[900] uppercase tracking-widest px-3 py-1.5 rounded-full bg-[#e86f38]/30 border border-[#e86f38]/40 text-[#f4a24c]">
            VITA Workshop · CVPR 2026
          </span>
        </div>

        <h1 class="text-3xl md:text-4xl font-[900] leading-tight tracking-tight mb-3">
          Towards Always-On Wearable AI That Perceives, Understands, and Assists
        </h1>

        <div class="flex flex-wrap gap-x-5 gap-y-1 text-white/70 text-sm font-[700] mb-6">
          <span>📅 June 3, 2026 · 17:00–17:30</span>
          <span>📍 Room 108</span>
          <span>🎤 Antonino Furnari</span>
        </div>

        <p class="text-white/80 font-[600] leading-relaxed text-base">
          This presentation outlines a framework for <strong class="text-white font-[900]">Collaborative AI</strong>, focusing on three pillars: sensing the world under physical constraints (<em>Cognitive Economy</em>), grounding perception into external structures (<em>Knowledge Grounding</em>), and providing empowering user feedback (<em>Optimal Intervention</em>).
        </p>

        <!-- Mini paper previews -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6 border-t border-white/10 pt-6">
          {papers.map((paper) => (
            <a href={`/research/${paper.pubId}`} class="bg-white/5 border border-white/10 rounded-xl p-3 flex flex-col justify-between hover:bg-white/10 hover:border-white/20 transition-all hover:scale-[1.02] text-left group text-decoration-none">
              <div>
                <div class="flex items-center justify-between mb-1">
                  <span class="text-lg">{paper.emoji}</span>
                  <span class="text-[9px] font-[900] uppercase tracking-wider px-1.5 py-0.5 rounded bg-white/10 text-white/80 group-hover:bg-white/20 group-hover:text-white transition-colors">View</span>
                </div>
                <span class="font-[900] text-xs block text-white/90 leading-tight mb-1">{paper.title}</span>
                <span class="text-[10px] text-white/60 font-[600] line-clamp-2 leading-tight">{paper.subtitle}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Framework pillars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {[
        { icon: "⚡", label: "Cognitive Economy", desc: "Sensing under energy & compute constraints", color: "#2a9d8f" },
        { icon: "🔗", label: "Knowledge Grounding", desc: "Grounding perception in external structures", color: "#7b5b9e" },
        { icon: "🎯", label: "Optimal Intervention", desc: "Empowering feedback at the right moment", color: "#e86f38" },
      ].map((pillar) => (
        <div class="rounded-2xl border p-5 flex flex-col gap-2"
          style={`background-color: ${pillar.color}10; border-color: ${pillar.color}30;`}>
          <div class="text-2xl">{pillar.icon}</div>
          <div class="font-[900] text-gray-900 dark:text-white text-base">{pillar.label}</div>
          <div class="text-sm font-[600] text-gray-600 dark:text-gray-400">{pillar.desc}</div>
        </div>
      ))}
    </div>

    <!-- Section heading -->
    <div class="border-b border-gray-200 dark:border-gray-800 pb-3">
      <h2 class="text-2xl font-[900] text-gray-900 dark:text-white tracking-tight">Featured Research</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 font-[600] mt-1">Works presented during the talk. Click on a paper to explore the full research page.</p>
    </div>

    <!-- Paper cards -->
    <div class="space-y-6">
      {papers.map((paper) => (
        <div class="rounded-3xl border overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 group"
          style={`background-color: ${paper.bgColor}; border-color: ${paper.borderColor};`}>
          <div class="flex flex-col md:flex-row">

            <!-- Teaser image column -->
            {paper.pub?.data.teaser && (
              <a href={`/research/${paper.pubId}`}
                class="flex-shrink-0 w-full md:w-56 bg-white dark:bg-gray-900 flex items-center justify-center p-4 border-b md:border-b-0 md:border-r border-inherit">
                <img
                  src={paper.pub.data.teaser}
                  alt={paper.title}
                  class="max-h-36 max-w-full object-contain group-hover:scale-[1.03] transition-transform duration-300"
                />
              </a>
            )}

            <!-- Content column -->
            <div class="flex-grow p-6 md:p-7">
              <!-- Header row -->
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="text-xl">{paper.emoji}</span>
                <span class="text-xs font-[900] uppercase tracking-widest px-2.5 py-1 rounded-full"
                  style={`background-color: ${paper.accentColor}20; color: ${paper.accentColor};`}>
                  {paper.themeIcon} {paper.theme}
                </span>
                {paper.award && (
                  <span class="text-xs font-[900] uppercase tracking-widest px-2.5 py-1 rounded-full bg-amber-50 dark:bg-amber-950/20 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-900/30">
                    🏆 {paper.award}
                  </span>
                )}
              </div>

              <a href={`/research/${paper.pubId}`}
                class="block text-xl font-[900] text-gray-900 dark:text-white mb-0.5 hover:underline decoration-2 underline-offset-2 leading-tight">
                {paper.title}
              </a>
              <p class="text-sm font-[700] mb-3" style={`color: ${paper.accentColor};`}>
                {paper.subtitle}
              </p>

              <div class="space-y-2.5 text-sm">
                <div class="flex gap-2">
                  <span class="font-[900] text-gray-700 dark:text-gray-300 whitespace-nowrap">Focus:</span>
                  <span class="font-[600] text-gray-600 dark:text-gray-400">{paper.focus}</span>
                </div>
                <div class="flex gap-2">
                  <span class="font-[900] text-gray-700 dark:text-gray-300 whitespace-nowrap">Overview:</span>
                  <span class="font-[600] text-gray-600 dark:text-gray-400">{paper.overview}</span>
                </div>
                <div class="flex gap-2 rounded-xl px-3 py-2" style={`background-color: ${paper.accentColor}15;`}>
                  <span class="font-[900] whitespace-nowrap" style={`color: ${paper.accentColor};`}>Key Finding:</span>
                  <span class="font-[700] text-gray-700 dark:text-gray-300">{paper.finding}</span>
                </div>
              </div>

              <!-- Links -->
              <div class="flex flex-wrap gap-2 mt-4">
                <a href={`/research/${paper.pubId}`}
                  class="inline-flex items-center gap-1.5 text-xs font-[900] px-3 py-1.5 rounded-xl transition-colors"
                  style={`color: ${paper.accentColor}; background-color: ${paper.accentColor}18;`}>
                  Paper Page <ExternalLink size={12} />
                </a>
                {paper.pub?.data.links?.map((link: { label: string; url: string }) => (
                  <a href={link.url} target="_blank" rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-xs font-[900] px-3 py-1.5 rounded-xl bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
                    {link.label} <ExternalLink size={12} />
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Footer note -->
    <div class="rounded-2xl border border-gray-100 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 p-6 text-center">
      <p class="text-sm font-[700] text-gray-500 dark:text-gray-400">
        Slides will be shared after the talk.
        Follow <a href="https://vita-workshop.github.io/" target="_blank" rel="noopener noreferrer"
          class="text-blue-600 dark:text-blue-400 hover:underline font-[900]">VITA Workshop</a> for live updates.
      </p>
    </div>

  </div>
</Layout>
